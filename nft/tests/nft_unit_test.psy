#[derive(Storage)]
pub struct NFTSlot {
    pub token_id: Felt,
    pub is_active: Felt,
    pub metadata_hash: Hash,
}

#[derive(Storage)]
pub struct NFTOutbox {
    pub token_id_0: Felt,
    pub metadata_hash_0: Hash,
    pub token_id_1: Felt,
    pub metadata_hash_1: Hash,
    pub token_id_2: Felt,
    pub metadata_hash_2: Hash,
    pub token_id_3: Felt,
    pub metadata_hash_3: Hash,
    pub nonce_sent: Felt,
    pub nonce_claimed: Felt,
}

#[derive(Event)]
pub struct NFTMintEvent {
    pub to: Felt,
    pub token_id: Felt,
    pub metadata_hash: Hash,
}

#[derive(Event)]
pub struct NFTTransferEvent {
    pub from: Felt,
    pub to: Felt,
    pub token_id: Felt,
    pub metadata_hash: Hash,
}

#[derive(Event)]
pub struct NFTClaimEvent {
    pub to: Felt,
    pub from: Felt,
    pub token_id: Felt,
    pub metadata_hash: Hash,
}

#[derive(Event)]
pub struct SetCollectionMetadataEvent {
    pub symbol: Felt,
    pub base_uri_hash: Hash,
}

#[derive(Event)]
pub struct AuthorityChangeEvent {
    pub new_authority: Felt,
}

#[contract]
#[derive(Storage)]
pub struct PsyNFTContract {
    pub balance: Felt,
    pub mint_authority: Felt,
    pub is_mint_renounced: Felt,
    pub total_minted: Felt,
    pub symbol: Felt,
    pub base_uri_hash: Hash,
    pub owned_tokens: [NFTSlot; 128],
    pub outbox: [NFTOutbox; 16777216],
}

impl PsyNFTContractRef {
    #[contract_method]
    pub fn set_collection_metadata(symbol: Felt, base_uri_hash: Hash) {
        let caller = get_user_id();
        let c = PsyNFTContractRef::new(ContractMetadata::current());
        assert(c.is_mint_renounced.get() == 0, "contract administration has been renounced");
        let auth = c.mint_authority.get();
        assert(auth != 0, "mint authority not initialized");
        assert(caller == auth, "only mint authority can set collection metadata");
        c.symbol = symbol;
        c.base_uri_hash = base_uri_hash;
        let ev = new SetCollectionMetadataEvent {
            symbol: symbol,
            base_uri_hash: base_uri_hash,
        };
        ev.emit();
    }

    #[contract_method]
    pub fn mint(slot_idx: Felt, local_id: Felt, metadata_hash: Hash) {
        assert(slot_idx < 128, "slot index out of range");
        assert(local_id > 0, "local_id must be non-zero");
        let caller = get_user_id();
        let c = PsyNFTContractRef::new(ContractMetadata::current());
        assert(c.is_mint_renounced.get() == 0, "minting has been renounced");
        let auth = c.mint_authority.get();
        assert(auth != 0, "mint authority not initialized");
        assert(caller == auth, "only mint authority can mint");
        let slot = c.owned_tokens[slot_idx].get();
        assert(slot.is_active == 0, "slot already occupied");

        // Compute globally unique token_id via on-chain Poseidon: Hash(creator, local_id)
        let token_id = hash_two_to_one([caller, 0, 0, 0], [local_id, 0, 0, 0])[0];

        c.owned_tokens[slot_idx] = new NFTSlot {
            token_id: token_id,
            is_active: 1,
            metadata_hash: metadata_hash,
        };
        assert(c.balance.get() < 18446744069414584320, "balance overflow");
        c.balance += 1;
        assert(c.total_minted.get() < 18446744069414584320, "total_minted overflow");
        c.total_minted += 1;
        let ev = new NFTMintEvent {
            to: caller,
            token_id: token_id,
            metadata_hash: metadata_hash,
        };
        ev.emit();
    }

    #[contract_method]
    pub fn renounce_mint_authority() {
        let caller = get_user_id();
        let c = PsyNFTContractRef::new(ContractMetadata::current());
        let auth = c.mint_authority.get();
        assert(auth != 0, "mint authority not initialized");
        assert(caller == auth, "only mint authority can renounce");
        c.is_mint_renounced = 1;
        c.mint_authority = 0;
        let ev = new AuthorityChangeEvent {
            new_authority: 0,
        };
        ev.emit();
    }

    #[contract_method]
    pub fn set_mint_authority(new_authority: Felt) {
        let caller = get_user_id();
        let c = PsyNFTContractRef::new(ContractMetadata::current());
        assert(c.is_mint_renounced.get() == 0, "minting has been renounced");
        let auth = c.mint_authority.get();
        if auth != 0 {
            assert(caller == auth, "only mint authority can transfer authority");
        };
        assert(new_authority != 0, "use renounce_mint_authority to revoke");
        c.mint_authority = new_authority;
        let ev = new AuthorityChangeEvent {
            new_authority: new_authority,
        };
        ev.emit();
    }

    #[contract_method]
    pub fn transfer(slot_idx: Felt, recipient: Felt) {
        assert(slot_idx < 128, "slot index out of range");
        let caller = get_user_id();
        assert(recipient != 0, "recipient cannot be zero address");
        assert(recipient != caller, "cannot transfer to self");
        let c = PsyNFTContractRef::new(ContractMetadata::current());
        let slot = c.owned_tokens[slot_idx].get();
        assert(slot.is_active == 1, "no active NFT in slot");
        let token_id = slot.token_id;
        let metadata_hash = slot.metadata_hash;

        // Check FIFO sliding window capacity (max 4 in-flight transfers)
        let prev_outbox = c.outbox[recipient].get();
        let in_flight = prev_outbox.nonce_sent - prev_outbox.nonce_claimed;
        assert(in_flight < 4, "FIFO outbox queue full: 4 uncollected transfers in-flight");

        // Clear local slot
        let zero_hash: Hash = [0, 0, 0, 0];
        c.owned_tokens[slot_idx] = new NFTSlot {
            token_id: 0,
            is_active: 0,
            metadata_hash: zero_hash,
        };
        assert(c.balance.get() > 0, "balance underflow");
        c.balance -= 1;

        // Put in FIFO circular buffer slot (nonce_sent & 3)
        let queue_slot: Felt = prev_outbox.nonce_sent & 3;
        let mut t0 = prev_outbox.token_id_0;
        let mut m0 = prev_outbox.metadata_hash_0;
        let mut t1 = prev_outbox.token_id_1;
        let mut m1 = prev_outbox.metadata_hash_1;
        let mut t2 = prev_outbox.token_id_2;
        let mut m2 = prev_outbox.metadata_hash_2;
        let mut t3 = prev_outbox.token_id_3;
        let mut m3 = prev_outbox.metadata_hash_3;

        if queue_slot == 0 {
            t0 = token_id;
            m0 = metadata_hash;
        } else if queue_slot == 1 {
            t1 = token_id;
            m1 = metadata_hash;
        } else if queue_slot == 2 {
            t2 = token_id;
            m2 = metadata_hash;
        } else {
            t3 = token_id;
            m3 = metadata_hash;
        };

        assert(prev_outbox.nonce_sent < 18446744069414584320, "nonce_sent overflow");
        c.outbox[recipient] = new NFTOutbox {
            token_id_0: t0,
            metadata_hash_0: m0,
            token_id_1: t1,
            metadata_hash_1: m1,
            token_id_2: t2,
            metadata_hash_2: m2,
            token_id_3: t3,
            metadata_hash_3: m3,
            nonce_sent: prev_outbox.nonce_sent + 1,
            nonce_claimed: prev_outbox.nonce_claimed,
        };

        let ev = new NFTTransferEvent {
            from: caller,
            to: recipient,
            token_id: token_id,
            metadata_hash: metadata_hash,
        };
        ev.emit();
    }
}

#[test]
fn test_nft_lifecycle() {
    let c = PsyNFTContractRef::new(ContractMetadata::current());

    // 1. Explicitly initialize authority
    PsyNFTContractRef::set_mint_authority(5);
    assert_eq(c.mint_authority.get(), 5, "mint authority should be 5");

    let base_uri_hash: Hash = [10, 20, 30, 40];
    PsyNFTContractRef::set_collection_metadata(5264217, base_uri_hash);
    assert_eq(c.symbol.get(), 5264217, "collection symbol should be set");

    let token_hash_0: Hash = [1, 2, 3, 4];
    PsyNFTContractRef::mint(0, 101, token_hash_0);
    let s0 = c.owned_tokens[0].get();
    let expected_id_0 = hash_two_to_one([5, 0, 0, 0], [101, 0, 0, 0])[0];
    assert_eq(s0.token_id, expected_id_0, "slot 0 token_id should match derived hash");
    assert_eq(s0.is_active, 1, "slot 0 should be active");
    assert_eq(s0.metadata_hash[0], 1, "slot 0 metadata_hash[0] should be 1");
    assert_eq(c.balance.get(), 1, "balance should be 1");
    assert_eq(c.total_minted.get(), 1, "total_minted should be 1");

    let token_hash_1: Hash = [5, 6, 7, 8];
    PsyNFTContractRef::mint(1, 202, token_hash_1);
    let s1 = c.owned_tokens[1].get();
    let expected_id_1 = hash_two_to_one([5, 0, 0, 0], [202, 0, 0, 0])[0];
    assert_eq(s1.token_id, expected_id_1, "slot 1 token_id should match derived hash");
    assert_eq(s1.is_active, 1, "slot 1 should be active");
    assert_eq(c.balance.get(), 2, "balance should be 2");
    assert_eq(c.total_minted.get(), 2, "total_minted should be 2");

    PsyNFTContractRef::transfer(0, 777);
    let s0_after = c.owned_tokens[0].get();
    assert_eq(s0_after.token_id, 0, "slot 0 token_id should be cleared");
    assert_eq(s0_after.is_active, 0, "slot 0 should be inactive");
    assert_eq(c.balance.get(), 1, "balance should be 1 after transfer");
    let ob = c.outbox[777].get();
    assert_eq(ob.token_id_0, expected_id_0, "outbox token_id_0 should match derived hash");
    assert_eq(ob.metadata_hash_0[0], 1, "outbox metadata_hash_0[0] should be 1");
    assert_eq(ob.nonce_sent, 1, "outbox nonce_sent should be 1");

    PsyNFTContractRef::transfer(1, 777);
    let s1_after = c.owned_tokens[1].get();
    assert_eq(s1_after.token_id, 0, "slot 1 token_id should be cleared");
    assert_eq(s1_after.is_active, 0, "slot 1 should be inactive");
    assert_eq(c.balance.get(), 0, "balance should be 0 after second transfer");
    let ob2 = c.outbox[777].get();
    assert_eq(ob2.token_id_0, expected_id_0, "outbox slot 0 should retain expected_id_0");
    assert_eq(ob2.token_id_1, expected_id_1, "outbox slot 1 should match expected_id_1");
    assert_eq(ob2.metadata_hash_1[0], 5, "outbox metadata_hash_1[0] should be 5");
    assert_eq(ob2.nonce_sent, 2, "outbox nonce_sent should be 2");

    PsyNFTContractRef::renounce_mint_authority();
    assert_eq(c.is_mint_renounced.get(), 1, "minting should be renounced");
    assert_eq(c.mint_authority.get(), 0, "authority should be zero");
}