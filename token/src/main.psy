#[derive(Storage)]
pub struct OtherUserInfo {
    pub amount_sent: Felt,
    pub amount_claimed: Felt,
}

#[derive(Storage)]
pub struct DelegationChannel {
    pub spender: Felt,
    pub allocated_amount: Felt,
    pub channel_version: Felt,
    // 0 = INACTIVE, 1 = ACTIVE, 2 = REVOKE_PENDING, 3 = CLOSED
    pub status: Felt
}

#[derive(Storage)]
pub struct DelegationSpend {
    pub spent: Felt,
    pub closed: Felt,
    pub channel_version: Felt,
}

pub struct PrivateClaimProof {
    pub siblings: [Hash; 16],
    pub index: Felt,
}

pub struct ProofPublicInputsPreimage {
    pub receiver: Hash,
    pub amount: Felt,
    pub user_tree_root: Hash,
    pub checkpoint_id: Felt,
    pub note_root_slot: Felt,
    pub nullifier_hash: Hash,
}

#[derive(Event)]
pub struct MintEvent {
    pub to: Felt,
    pub amount: Felt,
}

#[derive(Event)]
pub struct BurnEvent {
    pub amount: Felt,
}

#[derive(Event)]
pub struct BurnSettledEvent {
    pub sender: Felt,
    pub amount: Felt,
}

#[derive(Event)]
pub struct MaxSupplySetEvent {
    pub cap: Felt,
}

#[derive(Event)]
pub struct TransferEvent {
    pub to: Felt,
    pub amount: Felt,
}

#[derive(Event)]
pub struct ClaimEvent {
    pub from: Felt,
    pub amount: Felt,
}

#[derive(Event)]
pub struct DelegationEvent {
    pub channel_idx: Felt,
    pub spender: Felt,
    pub amount: Felt,
}

#[derive(Event)]
pub struct RequestRevokeDelegationEvent {
    pub channel_idx: Felt
}

#[derive(Event)]
pub struct CloseDelegationEvent {
    pub owner: Felt,
    pub channel_idx: Felt,
    pub channel_version: Felt,
    pub spent_amount: Felt,
}

#[derive(Event)]
pub struct FinalizeRevokeDelegationEvent {
    pub channel_idx: Felt,
    pub spender: Felt,
    pub refunded_amount: Felt,
}

#[derive(Event)]
pub struct SpendDelegationEvent {
    pub channel_idx: Felt,
    pub spender: Felt,
    pub recipient: Felt,
    pub amount: Felt,
}

#[derive(Event)]
pub struct AuthorityChangeEvent {
    pub new_authority: Felt,
}

#[derive(Event)]
pub struct SetMetadataEvent {
    pub symbol: Felt,
    pub decimals: Felt,
}

#[derive(Event)]
pub struct SetExtendedMetadataEvent {
    pub name: [Felt; 2],
    pub token_uri: [Felt; 5],
}

#[derive(Event)]
pub struct PrivateTransferEvent {
    pub commitment: Hash,
    pub note_index: Felt,
}

#[derive(Event)]
pub struct PrivateClaimEvent {
    pub nullifier_hash: Hash,
    pub receiver: Hash,
    pub amount: Felt,
}

pub const ISSUER_USER_ID: Felt = 5;

fn assert_caller_is_deployer() {
    let contract_id = get_contract_id();
    let deployer = get_contract_deployer(contract_id);
    let user_pk = get_user_public_key_hash();
    assert(
        user_pk[0] == deployer[0]
        && user_pk[1] == deployer[1]
        && user_pk[2] == deployer[2]
        && user_pk[3] == deployer[3],
        "only contract deployer is authorized"
    );
}

#[contract]
#[derive(Storage)]
pub struct PsyTokenContract {
    pub balance: Felt,
    pub last_claimed_pow_rewards_checkpoint_id: Felt,
    pub claimed_rewards: Felt,
    pub other_user_info: [OtherUserInfo; 16777216],
    pub note_count: Felt,
    pub note_root: Hash,
    pub last_path: [Hash; 20],
    pub mint_authority: Felt,
    pub is_mint_renounced: Felt,
    pub total_minted: Felt,
    pub total_supply: Felt,
    pub max_supply: Felt,
    pub burn_requested: Felt,
    pub burn_settled: [Felt; 16777216],
    pub decimals: Felt,
    pub symbol: Felt,
    pub name: [Felt; 2],
    pub token_uri: [Felt; 5],
    pub delegations: [DelegationChannel; 16],
    pub delegation_spends: [DelegationSpend; 268435456],
    pub state_map: Map<Hash, Hash, 1048576u32>,
}

impl PsyTokenContractRef {
    #[contract_method]
    pub fn set_metadata(symbol: Felt, decimals: Felt) {
        assert(get_user_id() == ISSUER_USER_ID, "caller is not in canonical ISSUER_USER_ID partition");
        assert_caller_is_deployer();
        let caller = get_user_id();
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        assert(c.is_mint_renounced.get() == 0, "token administration has been renounced");
        let auth = c.mint_authority.get();
        if auth == 0 {
            c.mint_authority = caller;
        } else {
            assert(caller == auth, "caller is not authorized to set metadata");
        };
        assert(decimals <= 18, "decimals exceed maximum supported precision");
        c.symbol = symbol;
        c.decimals = decimals;
        let ev = new SetMetadataEvent {
            symbol: symbol,
            decimals: decimals,
        };
        ev.emit();
    }

    #[contract_method]
    pub fn set_extended_metadata(name: [Felt; 2], token_uri: [Felt; 5]) {
        assert(get_user_id() == ISSUER_USER_ID, "only issuer can set extended metadata");
        assert_caller_is_deployer();
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        assert(c.is_mint_renounced.get() == 0, "token administration has been renounced");
        assert(c.mint_authority.get() == get_user_id(), "mint authority not initialized");
        c.name = name;
        c.token_uri = token_uri;
        let ev = new SetExtendedMetadataEvent {
            name: name,
            token_uri: token_uri,
        };
        ev.emit();
    }

    #[contract_method]
    pub fn set_max_supply(cap: Felt) {
        assert(get_user_id() == ISSUER_USER_ID, "only issuer can set max supply");
        assert_caller_is_deployer();
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        assert(c.is_mint_renounced.get() == 0, "minting has been renounced");
        assert(c.mint_authority.get() == get_user_id(), "mint authority not initialized");
        assert(c.total_minted.get() == 0 && c.max_supply.get() == 0, "max supply can only be set once before minting");
        assert(cap > 0, "max supply must be positive");
        c.max_supply = cap;
        let ev = new MaxSupplySetEvent { cap: cap };
        ev.emit();
    }

    #[contract_method]
    pub fn mint(amount: Felt) {
        assert(amount > 0, "mint amount must be positive");
        assert(get_user_id() == ISSUER_USER_ID, "only designated ISSUER_USER_ID partition can mint");
        assert_caller_is_deployer();
        let caller = get_user_id();
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        assert(c.is_mint_renounced.get() == 0, "minting has been permanently renounced");
        let auth = c.mint_authority.get();
        assert(auth != 0, "mint authority not initialized");
        assert(caller == auth, "only authorized mint authority can mint in deployer partition");
        let current_balance = c.balance.get();
        assert(amount <= 18446744069414584320 - current_balance, "balance overflow");
        let current_total = c.total_minted.get();
        assert(amount <= 18446744069414584320 - current_total, "total minted overflow");
        let cap = c.max_supply.get();
        assert(cap == 0 || amount <= cap - current_total, "max supply exceeded");
        let current_supply = c.total_supply.get();
        assert(amount <= 18446744069414584320 - current_supply, "total supply overflow");

        c.total_minted = current_total + amount;
        c.total_supply = current_supply + amount;
        c.balance = current_balance + amount;

        let ev = new MintEvent {
            to: caller,
            amount: amount,
        };
        ev.emit();
    }

    #[contract_method]
    pub fn mint_to(recipient: Felt, amount: Felt) {
        assert(get_user_id() == ISSUER_USER_ID, "only issuer can mint to recipient");
        assert_caller_is_deployer();
        assert(recipient != 0 && recipient < 16777216 && recipient != get_user_id(), "invalid mint recipient");
        assert(amount > 0, "mint amount must be positive");
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        assert(c.is_mint_renounced.get() == 0, "minting has been permanently renounced");
        assert(c.mint_authority.get() == get_user_id(), "caller is not mint authority");
        let minted = c.total_minted.get();
        let supply = c.total_supply.get();
        assert(amount <= 18446744069414584320 - minted, "total minted overflow");
        let cap = c.max_supply.get();
        assert(cap == 0 || amount <= cap - minted, "max supply exceeded");
        assert(amount <= 18446744069414584320 - supply, "total supply overflow");
        let info = c.other_user_info[recipient].get();
        assert(amount <= 18446744069414584320 - info.amount_sent, "amount sent overflow");
        c.other_user_info[recipient] = new OtherUserInfo {
            amount_sent: info.amount_sent + amount,
            amount_claimed: info.amount_claimed,
        };
        c.total_minted = minted + amount;
        c.total_supply = supply + amount;
        let ev = new MintEvent { to: recipient, amount: amount };
        ev.emit();
    }

    #[contract_method]
    pub fn burn(amount: Felt) {
        assert(amount > 0, "burn amount must be positive");
        assert(get_user_id() < 16777216, "burning user_id exceeds settlement bounds");
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        assert(current_balance >= amount, "insufficient balance to burn");
        let requested = c.burn_requested.get();
        assert(amount <= 18446744069414584320 - requested, "burn request overflow");
        c.balance = current_balance - amount;
        c.burn_requested = requested + amount;
        let ev = new BurnEvent {
            amount: amount,
        };
        ev.emit();
    }

    #[contract_method]
    pub fn settle_burn(sender: Felt) {
        assert(get_user_id() == ISSUER_USER_ID, "only issuer can settle burns");
        assert_caller_is_deployer();
        assert(sender != 0 && sender < 16777216, "burn sender out of bounds");
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let remote = PsyTokenContractRef::new(ContractMetadata::new(get_contract_id(), sender));
        let requested = remote.burn_requested.get();
        let settled = c.burn_settled[sender].get();
        assert(requested > settled, "no pending burn to settle");
        let amount = requested - settled;
        let supply = c.total_supply.get();
        assert(supply >= amount, "burn exceeds total supply");
        c.burn_settled[sender] = requested;
        c.total_supply = supply - amount;
        let ev = new BurnSettledEvent { sender: sender, amount: amount };
        ev.emit();
    }

    // In Psy Protocol's partitioned state model, minting capability is strictly bound to the
    // canonical ISSUER_USER_ID partition (get_user_id() == ISSUER_USER_ID && assert_caller_is_deployer()).
    // Delegating authority to another partition (new_authority != caller) would create an un-mintable
    // deadlock because non-issuer partitions cannot satisfy the partition constraint in mint().
    // Therefore, set_mint_authority only allows re-affirming or initializing the caller within the
    // deployer partition. Authority revocation is handled exclusively via renounce_mint_authority().
    #[contract_method]
    pub fn set_mint_authority(new_authority: Felt) {
        assert(get_user_id() == ISSUER_USER_ID, "only designated ISSUER_USER_ID partition can set mint authority");
        assert_caller_is_deployer();
        let caller = get_user_id();
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        assert(c.is_mint_renounced.get() == 0, "minting has been renounced");
        assert(new_authority != 0, "use renounce_mint_authority to revoke");
        assert(new_authority == caller, "cannot transfer authority outside deployer partition in single-source model");
        c.mint_authority = new_authority;
        let ev = new AuthorityChangeEvent {
            new_authority: new_authority,
        };
        ev.emit();
    }

    #[contract_method]
    pub fn renounce_mint_authority() {
        assert(get_user_id() == ISSUER_USER_ID, "only designated ISSUER_USER_ID partition can renounce mint authority");
        assert_caller_is_deployer();
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let auth = c.mint_authority.get();
        assert(auth != 0, "mint authority not initialized");
        c.is_mint_renounced = 1;
        c.mint_authority = 0;
        let ev = new AuthorityChangeEvent {
            new_authority: 0,
        };
        ev.emit();
    }

    #[contract_method]
    pub fn transfer(recipient: Felt, amount: Felt) {
        let caller = get_user_id();
        assert(recipient != 0, "recipient cannot be zero address");
        assert(recipient != caller, "cannot transfer to self");
        assert(recipient < 16777216, "recipient user_id exceeds outbox bounds");
        assert(caller < 16777216, "caller user_id exceeds outbox bounds");
        assert(amount > 0, "transfer amount must be positive");
        assert(amount <= 18446744069414584320, "amount exceeds field safe range");
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        assert(current_balance >= amount, "insufficient balance");
        let recipient_info = c.other_user_info[recipient].get();
        assert(recipient_info.amount_sent <= 18446744069414584320 - amount, "amount sent overflow");
        c.other_user_info[recipient] = new OtherUserInfo {
            amount_sent: recipient_info.amount_sent + amount,
            amount_claimed: recipient_info.amount_claimed,
        };
        c.balance = current_balance - amount;
        let ev = new TransferEvent {
            to: recipient,
            amount: amount,
        };
        ev.emit();
    }

    #[contract_method]
    pub fn claim(sender: Felt) {
        let self_user_id = get_user_id();
        assert(sender != 0, "sender cannot be zero address");
        assert(sender != self_user_id, "cannot claim from self");
        assert(sender < 16777216, "sender user_id exceeds inbox bounds");
        assert(self_user_id < 16777216, "caller user_id exceeds inbox bounds");
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let sender_contract = PsyTokenContractRef::new(ContractMetadata::new(get_contract_id(), sender));
        let sender_total_sent = sender_contract.other_user_info[self_user_id].get().amount_sent;
        let sender_info = c.other_user_info[sender].get();
        assert(sender_total_sent > sender_info.amount_claimed, "no tokens to claim from this sender");
        let claimable = sender_total_sent - sender_info.amount_claimed;
        let current_balance = c.balance.get();
        assert(claimable <= 18446744069414584320 - current_balance, "balance overflow");
        c.other_user_info[sender] = new OtherUserInfo {
            amount_sent: sender_info.amount_sent,
            amount_claimed: sender_total_sent,
        };
        c.balance = current_balance + claimable;
        let ev = new ClaimEvent {
            from: sender,
            amount: claimable,
        };
        ev.emit();
    }

    #[contract_method]
    pub fn batch_transfer_2(recipients: [Felt; 2], amounts: [Felt; 2]) {
        let caller = get_user_id();
        assert(caller < 16777216, "caller user_id exceeds outbox bounds");
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        let mut total_amount = 0;
        for i in 0u32..2u32 {
            let amt = amounts[i as Felt];
            assert(amt <= 18446744069414584320 - total_amount, "total amount overflow");
            total_amount = total_amount + amt;
        }
        assert(current_balance >= total_amount, "insufficient balance for batch transfer");
        for i in 0u32..2u32 {
            let recipient = recipients[i as Felt];
            let amount = amounts[i as Felt];
            if amount > 0 {
                assert(recipient != 0, "recipient cannot be zero address");
                assert(recipient != caller, "cannot transfer to self");
                assert(recipient < 16777216, "recipient user_id exceeds outbox bounds");
                let recipient_info = c.other_user_info[recipient].get();
                assert(recipient_info.amount_sent <= 18446744069414584320 - amount, "amount sent overflow");
                c.other_user_info[recipient] = new OtherUserInfo {
                    amount_sent: recipient_info.amount_sent + amount,
                    amount_claimed: recipient_info.amount_claimed,
                };
                let ev = new TransferEvent {
                    to: recipient,
                    amount: amount,
                };
                ev.emit();
            }
        }
        c.balance = current_balance - total_amount;
    }

    #[contract_method]
    pub fn batch_transfer_5(recipients: [Felt; 5], amounts: [Felt; 5]) {
        let caller = get_user_id();
        assert(caller < 16777216, "caller user_id exceeds outbox bounds");
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        let mut total_amount = 0;
        for i in 0u32..5u32 {
            let amt = amounts[i as Felt];
            assert(amt <= 18446744069414584320 - total_amount, "total amount overflow");
            total_amount = total_amount + amt;
        }
        assert(current_balance >= total_amount, "insufficient balance for batch transfer");
        for i in 0u32..5u32 {
            let recipient = recipients[i as Felt];
            let amount = amounts[i as Felt];
            if amount > 0 {
                assert(recipient != 0, "recipient cannot be zero address");
                assert(recipient != caller, "cannot transfer to self");
                assert(recipient < 16777216, "recipient user_id exceeds outbox bounds");
                let recipient_info = c.other_user_info[recipient].get();
                assert(recipient_info.amount_sent <= 18446744069414584320 - amount, "amount sent overflow");
                c.other_user_info[recipient] = new OtherUserInfo {
                    amount_sent: recipient_info.amount_sent + amount,
                    amount_claimed: recipient_info.amount_claimed,
                };
                let ev = new TransferEvent {
                    to: recipient,
                    amount: amount,
                };
                ev.emit();
            }
        }
        c.balance = current_balance - total_amount;
    }

    #[contract_method]
    pub fn open_delegation_channel(channel_idx: Felt, spender: Felt, amount: Felt) {
        assert(channel_idx < 16, "channel index out of bounds");
        assert(amount > 0, "amount must be positive");
        assert(spender != 0, "spender cannot be zero address");
        let caller = get_user_id();
        assert(caller < 16777216, "owner user_id exceeds channel bounds");
        assert(spender < 16777216, "spender user_id exceeds channel bounds");
        assert(spender != caller, "cannot delegate to self");
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        assert(current_balance >= amount, "insufficient balance to allocate");
        let existing = c.delegations[channel_idx].get();
        assert(existing.status == 0 || existing.status == 3, "channel currently active; revoke or close first");
        assert(existing.channel_version < 18446744069414584320, "channel version overflow");
        c.balance = current_balance - amount;
        c.delegations[channel_idx] = new DelegationChannel {
            spender: spender,
            allocated_amount: amount,
            channel_version: existing.channel_version + 1,
            status: 1
        };
        let ev = new DelegationEvent {
            channel_idx: channel_idx,
            spender: spender,
            amount: amount,
        };
        ev.emit();
    }

    // Remote owner state may be historical. The spender's local versioned ledger
    // bounds total spending; a fresh REVOKE_PENDING read rejects spending, but an
    // earlier ACTIVE proof may still be accepted until the spender closes.
    #[contract_method]
    pub fn spend_delegation(owner: Felt, channel_idx: Felt, amount: Felt, recipient: Felt) {
        assert(channel_idx < 16, "channel index out of bounds");
        assert(amount > 0, "amount must be positive");
        assert(recipient != 0, "recipient cannot be zero address");
        assert(owner != 0, "owner cannot be zero address");
        assert(recipient < 16777216, "recipient user_id exceeds outbox bounds");
        assert(owner < 16777216, "owner user_id exceeds channel bounds");
        let caller = get_user_id();
        assert(caller < 16777216, "caller user_id exceeds outbox bounds");
        assert(recipient != caller, "cannot transfer to self");

        // 1. Read Owner partition
        let owner_contract = PsyTokenContractRef::new(ContractMetadata::new(get_contract_id(), owner));
        let ch = owner_contract.delegations[channel_idx].get();
        assert(caller == ch.spender, "caller is not authorized channel spender");
        assert(ch.status == 1, "channel is not active");

        // 2. Read and update the Spender's local, versioned ledger.
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let ledger_idx = owner * 16 + channel_idx;
        let ledger = c.delegation_spends[ledger_idx].get();
        assert(ledger.channel_version <= ch.channel_version, "historical delegation version cannot be reused");
        let mut local_spent: Felt = 0;
        if ledger.channel_version == ch.channel_version {
            assert(ledger.closed == 0, "delegation channel was closed by spender");
            local_spent = ledger.spent;
        } else {
            assert(ledger.channel_version == 0 || ledger.closed == 1, "prior delegation version remains open");
        };
        assert(local_spent <= ch.allocated_amount, "local spent exceeds allocated amount");
        let remaining = ch.allocated_amount - local_spent;
        assert(amount <= remaining, "insufficient delegation channel allowance");
        assert(local_spent <= 18446744069414584320 - amount, "delegation spent overflow");
        c.delegation_spends[ledger_idx] = new DelegationSpend {
            spent: local_spent + amount,
            closed: 0,
            channel_version: ch.channel_version,
        };

        // 3. Outbox spend to recipient
        let recipient_info = c.other_user_info[recipient].get();
        assert(recipient_info.amount_sent <= 18446744069414584320 - amount, "amount sent overflow");
        c.other_user_info[recipient] = new OtherUserInfo {
            amount_sent: recipient_info.amount_sent + amount,
            amount_claimed: recipient_info.amount_claimed,
        };

        let ev = new SpendDelegationEvent {
            channel_idx: channel_idx,
            spender: caller,
            recipient: recipient,
            amount: amount,
        };
        ev.emit();
    }

    #[contract_method]
    pub fn request_revoke_delegation(channel_idx: Felt) {
        assert(channel_idx < 16, "channel index out of bounds");
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let ch = c.delegations[channel_idx].get();
        assert(ch.status == 1, "channel is not in active status");
        c.delegations[channel_idx] = new DelegationChannel {
            spender: ch.spender,
            allocated_amount: ch.allocated_amount,
            channel_version: ch.channel_version,
            status: 2
        };
        let ev = new RequestRevokeDelegationEvent {
            channel_idx: channel_idx
        };
        ev.emit();
    }

    // Closing is a terminal write in the spender's own partition. A historical
    // proof of this closed record remains safe to use for the owner's refund:
    // the spender can no longer increase spent for this channel version.
    // Revocation is cooperative; a missing spender close leaves funds locked.
    #[contract_method]
    pub fn close_delegation_channel(owner: Felt, channel_idx: Felt, channel_version: Felt) {
        assert(owner != 0 && owner < 16777216, "owner user_id exceeds channel bounds");
        assert(channel_idx < 16, "channel index out of bounds");
        assert(channel_version > 0, "channel version must be positive");
        let caller = get_user_id();
        assert(caller < 16777216, "caller user_id exceeds channel bounds");
        assert(owner != caller, "cannot close a delegation to self");
        let owner_contract = PsyTokenContractRef::new(ContractMetadata::new(get_contract_id(), owner));
        let authorization = owner_contract.delegations[channel_idx].get();
        assert(authorization.spender == caller, "caller is not channel spender");
        assert(authorization.channel_version == channel_version, "channel version does not match owner authorization");
        assert(authorization.status == 1 || authorization.status == 2, "owner channel is not active");
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let ledger_idx = owner * 16 + channel_idx;
        let ledger = c.delegation_spends[ledger_idx].get();
        assert(ledger.channel_version <= channel_version, "historical delegation version cannot be closed again");
        let mut spent: Felt = 0;
        if ledger.channel_version == channel_version {
            assert(ledger.closed == 0, "delegation channel already closed by spender");
            spent = ledger.spent;
        } else {
            assert(ledger.channel_version == 0 || ledger.closed == 1, "prior delegation version remains open");
        };
        c.delegation_spends[ledger_idx] = new DelegationSpend {
            spent: spent,
            closed: 1,
            channel_version: channel_version,
        };
        let ev = new CloseDelegationEvent {
            owner: owner,
            channel_idx: channel_idx,
            channel_version: channel_version,
            spent_amount: spent,
        };
        ev.emit();
    }

    // Remote spender state may be historical. CLOSED is terminal in the
    // spender's current local ledger, so a proof of CLOSED with the exact
    // version and spent total is sufficient for a cooperative refund.
    #[contract_method]
    pub fn finalize_revoke_delegation(channel_idx: Felt, spender: Felt) {
        assert(channel_idx < 16, "channel index out of bounds");
        assert(spender < 16777216, "spender user_id exceeds channel bounds");
        let caller = get_user_id();
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let ch = c.delegations[channel_idx].get();
        assert(ch.status == 2, "revoke has not been requested for this channel");
        assert(spender == ch.spender, "spender does not match channel spender");
        // A historical CLOSED proof is safe: the Spender's own current ledger
        // forbids any later spending for this channel version.
        let spender_contract = PsyTokenContractRef::new(ContractMetadata::new(get_contract_id(), spender));
        let ledger_idx = caller * 16 + channel_idx;
        let settlement = spender_contract.delegation_spends[ledger_idx].get();
        assert(settlement.channel_version == ch.channel_version, "spender ledger version mismatch");
        assert(settlement.closed == 1, "spender has not closed delegation channel");
        let confirmed_spent: Felt = settlement.spent;
        assert(confirmed_spent <= ch.allocated_amount, "confirmed spent exceeds allocated amount");

        let unspent = ch.allocated_amount - confirmed_spent;
        let current_balance = c.balance.get();
        assert(unspent <= 18446744069414584320 - current_balance, "balance overflow");
        c.balance = current_balance + unspent;

        c.delegations[channel_idx] = new DelegationChannel {
            spender: 0,
            allocated_amount: 0,
            channel_version: ch.channel_version,
            status: 3
        };

        let ev = new FinalizeRevokeDelegationEvent {
            channel_idx: channel_idx,
            spender: spender,
            refunded_amount: unspent,
        };
        ev.emit();
    }

    #[contract_method]
    pub fn private_transfer(receiver: Hash, value: Felt, note_secret_hash: Hash) {
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        assert(value > 0, "value must be positive");
        assert(current_balance >= value, "insufficient balance");
        c.balance = current_balance - value;
        let value_hash: Hash = [value, 0, 0, 0];
        let commitment: Hash = hash_two_to_one(hash_two_to_one(receiver, value_hash), note_secret_hash);
        let idx = c.note_count.get();
        assert(idx < 1048576, "note tree is full");
        let mut current: Hash = commitment;
        let mut zero: Hash = [0, 0, 0, 0];
        let mut path_index: Felt = idx;
        for level in 0u32..20u32 {
            let level_index = level as Felt;
            let is_right: Felt = path_index & 1;
            if is_right == 0 {
                c.last_path[level_index] = current;
                current = hash_two_to_one(current, zero);
            } else {
                let left = c.last_path[level_index].get();
                current = hash_two_to_one(left, current);
            };
            zero = hash_two_to_one(zero, zero);
            path_index = path_index >> 1;
        }
        c.note_root = current;
        c.note_count = idx + 1;
        let ev = new PrivateTransferEvent {
            commitment: commitment,
            note_index: idx,
        };
        ev.emit();
    }

    #[contract_method]
    pub fn private_claim(
        nullifier_hash: Hash,
        receiver: Hash,
        amount: Felt,
        user_tree_root: Hash,
        checkpoint_id: Felt,
        note_root_slot: Felt,
        random0: Felt,
        random1: Felt,
        proof: PrivateClaimProof
    ) {
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        assert(proof.index < 65536, "proof index out of bounds");
        let preimage = new ProofPublicInputsPreimage {
            receiver: receiver,
            amount: amount,
            user_tree_root: user_tree_root,
            checkpoint_id: checkpoint_id,
            note_root_slot: note_root_slot,
            nullifier_hash: nullifier_hash
        };
        let public_inputs_hash: Hash = hash([
            preimage.receiver[0], preimage.receiver[1], preimage.receiver[2], preimage.receiver[3],
            preimage.amount,
            preimage.user_tree_root[0], preimage.user_tree_root[1], preimage.user_tree_root[2], preimage.user_tree_root[3],
            preimage.checkpoint_id,
            preimage.note_root_slot,
            preimage.nullifier_hash[0], preimage.nullifier_hash[1], preimage.nullifier_hash[2], preimage.nullifier_hash[3]
        ]);
        let private_note_inclusion_fingerprint: Hash = [
            1866130053021784426,
            4684972721646198880,
            8939938924988830351,
            15880983663605084668
        ];
        let leaf: Hash = hash_two_to_one(private_note_inclusion_fingerprint, public_inputs_hash);
        let mut current: Hash = leaf;
        for i in 0u32..16u32 {
            let level_index = i as Felt;
            let sibling: Hash = proof.siblings[level_index];
            let index_bit: Felt = (proof.index >> level_index) & 1;
            if index_bit == 0 {
                current = hash_two_to_one(current, sibling);
            } else {
                current = hash_two_to_one(sibling, current);
            };
        }
        let expected_root: Hash = get_session_proof_tree_root();
        assert(current == expected_root, "proof tree root mismatch");
        let expected_user_tree_root: Hash = get_checkpoint_user_tree_root(preimage.checkpoint_id);
        assert(preimage.user_tree_root == expected_user_tree_root, "user tree root does not match checkpoint state");
        assert(preimage.note_root_slot == 8388609, "invalid note root slot id");
        let expected_receiver: Hash = hash([get_user_id(), 1337, random0, random1]);
        assert(preimage.receiver == expected_receiver, "receiver does not match claiming user");
        let nullifier_key: Hash = preimage.nullifier_hash;
        assert(c.state_map.contains_ns(1, nullifier_key) == false, "nullifier already claimed");
        c.state_map.insert_ns(1, nullifier_key, [1, 0, 0, 0]);
        let cur_bal = c.balance.get();
        assert(amount <= 18446744069414584320 - cur_bal, "balance overflow");
        c.balance = cur_bal + amount;
        let ev = new PrivateClaimEvent {
            nullifier_hash: nullifier_hash,
            receiver: receiver,
            amount: amount,
        };
        ev.emit();
    }
}
