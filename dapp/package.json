{
  "name": "psy-dapp-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "configure": "node scripts/configure_issuer.mjs",
    "check:config": "node scripts/configure_issuer.mjs --check",
    "check:preflight": "node scripts/configure_issuer.mjs --check --strict",
    "check:deployer": "node scripts/deploy_checked.mjs --preflight-only",
    "deploy:checked": "node scripts/deploy_checked.mjs",
    "build:contract": "cd contract && psyup build",
    "build:contract:deploy": "npm run check:preflight && cd contract && psyup build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:markets": "node --test tests/*.test.mjs",
    "test:gateway": "cd .. && node --test market-client/*.test.mjs executor/gateway/*.test.mjs",
    "gateway": "cd .. && node executor/gateway/server.mjs executor/gateway/mainnet-beta-v3.json"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.6.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
