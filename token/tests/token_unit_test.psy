#[derive(Storage)]
pub struct OtherUserInfo {
    pub amount_sent: Felt,
    pub amount_claimed: Felt,
}

#[derive(Storage)]
pub struct DelegationChannel {
    pub spender: Felt,
    pub allocated_amount: Felt,
    pub spent_amount: Felt,
}

#[derive(Event)]
pub struct MintEvent {
    pub to: Felt,
    pub amount: Felt,
}

#[derive(Event)]
pub struct BurnEvent {
    pub amount: Felt,
}

#[derive(Event)]
pub struct TransferEvent {
    pub to: Felt,
    pub amount: Felt,
}

#[derive(Event)]
pub struct ClaimEvent {
    pub from: Felt,
    pub amount: Felt,
}

#[derive(Event)]
pub struct AuthorityChangeEvent {
    pub new_authority: Felt,
}

#[derive(Event)]
pub struct DelegationEvent {
    pub channel_idx: Felt,
    pub spender: Felt,
    pub amount: Felt,
}

#[derive(Event)]
pub struct RevokeDelegationEvent {
    pub channel_idx: Felt,
    pub refunded_amount: Felt,
}

#[derive(Event)]
pub struct SpendDelegationEvent {
    pub channel_idx: Felt,
    pub spender: Felt,
    pub recipient: Felt,
    pub amount: Felt,
}

#[derive(Event)]
pub struct PrivateTransferEvent {
    pub commitment: Hash,
    pub note_index: Felt,
}

#[contract]
#[derive(Storage)]
pub struct PsyTokenContract {
    pub balance: Felt,
    pub mint_authority: Felt,
    pub is_mint_renounced: Felt,
    pub other_user_info: [OtherUserInfo; 16777216],
    pub delegations: [DelegationChannel; 16],
    pub note_count: Felt,
    pub note_root: Hash,
    pub last_path: [Hash; 20],
}

impl PsyTokenContractRef {
    #[contract_method]
    pub fn mint(amount: Felt) {
        let caller = get_user_id();
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        assert(c.is_mint_renounced.get() == 0, "minting has been renounced");
        let auth = c.mint_authority.get();
        if auth == 0 {
            c.mint_authority = caller;
        }        
        else {
            assert(caller == auth, "only mint authority can mint");
        };
        c.balance += amount;
        let ev = new MintEvent {
            to: caller,
            amount: amount,
        };
        ev.emit();
    }
    #[contract_method]
    pub fn burn(amount: Felt) {
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        assert(c.balance.get() >= amount, "insufficient balance to burn");
        c.balance -= amount;
        let ev = new BurnEvent {
            amount: amount,
        };
        ev.emit();
    }
    #[contract_method]
    pub fn set_mint_authority(new_authority: Felt) {
        let caller = get_user_id();
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        assert(c.is_mint_renounced.get() == 0, "minting has been renounced");
        let auth = c.mint_authority.get();
        assert(auth != 0, "mint authority not initialized");
        assert(caller == auth, "only mint authority can transfer authority");
        assert(new_authority != 0, "use renounce_mint_authority to revoke");
        c.mint_authority = new_authority;
        let ev = new AuthorityChangeEvent {
            new_authority: new_authority,
        };
        ev.emit();
    }
    #[contract_method]
    pub fn renounce_mint_authority() {
        let caller = get_user_id();
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let auth = c.mint_authority.get();
        assert(auth != 0, "mint authority not initialized");
        assert(caller == auth, "only mint authority can renounce");
        c.is_mint_renounced = 1;
        c.mint_authority = 0;
        let ev = new AuthorityChangeEvent {
            new_authority: 0,
        };
        ev.emit();
    }
    #[contract_method]
    pub fn open_delegation_channel(channel_idx: Felt, spender: Felt, amount: Felt) {
        assert(channel_idx < 16, "channel index out of range");
        assert(amount > 0, "delegation amount must be positive");
        let caller = get_user_id();
        assert(spender != caller, "cannot delegate to self");
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        assert(c.balance.get() >= amount, "insufficient balance for delegation");
        c.balance -= amount;
        c.delegations[channel_idx] = new DelegationChannel {
            spender: spender,
            allocated_amount: amount,
            spent_amount: 0,
        };
        let ev = new DelegationEvent {
            channel_idx: channel_idx,
            spender: spender,
            amount: amount,
        };
        ev.emit();
    }
    #[contract_method]
    pub fn spend_delegation(channel_idx: Felt, amount: Felt, recipient: Felt) {
        assert(channel_idx < 16, "channel index out of bounds");
        assert(amount > 0, "amount must be positive");
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let ch = c.delegations[channel_idx].get();
        assert(ch.spender != 0, "channel is not active");
        let remaining = ch.allocated_amount - ch.spent_amount;
        assert(remaining >= amount, "insufficient delegation channel allowance");
        c.delegations[channel_idx] = new DelegationChannel {
            spender: ch.spender,
            allocated_amount: ch.allocated_amount,
            spent_amount: ch.spent_amount + amount,
        };
        let recipient_info = c.other_user_info[recipient].get();
        assert(recipient_info.amount_sent + amount > recipient_info.amount_sent, "amount sent overflow");
        c.other_user_info[recipient] = new OtherUserInfo {
            amount_sent: recipient_info.amount_sent + amount,
            amount_claimed: recipient_info.amount_claimed,
        };
        let ev = new SpendDelegationEvent {
            channel_idx: channel_idx,
            spender: ch.spender,
            recipient: recipient,
            amount: amount,
        };
        ev.emit();
    }
    #[contract_method]
    pub fn revoke_delegation_channel(channel_idx: Felt) {
        assert(channel_idx < 16, "channel index out of range");
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let channel = c.delegations[channel_idx].get();
        assert(channel.spender != 0, "channel is not active");
        let unspent = channel.allocated_amount - channel.spent_amount;
        c.balance += unspent;
        c.delegations[channel_idx] = new DelegationChannel {
            spender: 0,
            allocated_amount: 0,
            spent_amount: 0,
        };
        let ev = new RevokeDelegationEvent {
            channel_idx: channel_idx,
            refunded_amount: unspent,
        };
        ev.emit();
    }
    #[contract_method]
    pub fn private_transfer(receiver: Hash, value: Felt, note_secret_hash: Hash) {
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        assert(value > 0, "value must be positive");
        assert(current_balance >= value, "insufficient balance");
        c.balance = current_balance - value;
        let value_hash: Hash = [value, 0, 0, 0];
        let commitment: Hash = hash_two_to_one(hash_two_to_one(receiver, value_hash), note_secret_hash);
        let idx = c.note_count.get();
        assert(idx < 1048576, "note tree is full");
        let mut current: Hash = commitment;
        let mut zero: Hash = [0, 0, 0, 0];
        let mut path_index: Felt = idx;
        for level in 0u32..20u32 {
            let level_index = level as Felt;
            let is_right: Felt = path_index & 1;
            if is_right == 0 {
                c.last_path[level_index] = current;
                current = hash_two_to_one(current, zero);
            }            
            else {
                let left = c.last_path[level_index].get();
                current = hash_two_to_one(left, current);
            };
            zero = hash_two_to_one(zero, zero);
            path_index = path_index >> 1;
        }
        c.note_root = current;
        c.note_count = idx + 1;
        let ev = new PrivateTransferEvent {
            commitment: commitment,
            note_index: idx,
        };
        ev.emit();
    }
}

#[test]
fn test_token_mint_burn_delegation_lifecycle() {
    let c = PsyTokenContractRef::new(ContractMetadata::current());
    let initial_balance = c.balance.get();
    PsyTokenContractRef::mint(1000);
    assert_eq(c.balance.get(), initial_balance + 1000, "balance should increment by 1000");
    PsyTokenContractRef::burn(200);
    assert_eq(c.balance.get(), initial_balance + 800, "balance after burning 200 should be initial + 800");
    PsyTokenContractRef::open_delegation_channel(0, 888, 300);
    assert_eq(c.balance.get(), initial_balance + 500, "balance after locking 300 in channel should be initial + 500");
    let ch = c.delegations[0].get();
    assert_eq(ch.spender, 888, "channel spender should be 888");
    assert_eq(ch.allocated_amount, 300, "allocated amount should be 300");
    assert_eq(ch.spent_amount, 0, "initial spent amount should be 0");
    PsyTokenContractRef::spend_delegation(0, 100, 999);
    assert_eq(c.balance.get(), initial_balance + 500, "main balance should remain untouched at initial + 500");
    let ch_spent = c.delegations[0].get();
    assert_eq(ch_spent.spent_amount, 100, "channel spent amount should increment to 100");
    let ob_999 = c.other_user_info[999].get();
    assert_eq(ob_999.amount_sent, 100, "recipient 999 should have 100 sent in outbox");
    PsyTokenContractRef::revoke_delegation_channel(0);
    assert_eq(c.balance.get(), initial_balance + 700, "balance after revoking channel should be initial + 700 (refunded 200)");
    let ch_after = c.delegations[0].get();
    assert_eq(ch_after.spender, 0, "channel spender should be reset to 0");
    assert_eq(ch_after.allocated_amount, 0, "channel allocated amount should be reset to 0");
    assert_eq(ch_after.spent_amount, 0, "channel spent amount should be reset to 0");
    // 6. Shielded Private Transfer
    let receiver: Hash = [11, 22, 33, 44];
    let secret: Hash = [55, 66, 77, 88];
    PsyTokenContractRef::private_transfer(receiver, 250, secret);
    assert_eq(c.balance.get(), initial_balance + 450, "balance after private transfer of 250 should be initial + 450");
    assert_eq(c.note_count.get(), 1, "note_count should increment to 1");
    PsyTokenContractRef::renounce_mint_authority();
    assert_eq(c.is_mint_renounced.get(), 1, "is_mint_renounced should be 1");
    assert_eq(c.mint_authority.get(), 0, "mint_authority should be reset to 0");
}