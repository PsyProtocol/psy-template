{
  "name": "psy-token",
  "version": "1.0.0",
  "description": "PSY-20 Fungible Token Smart Contract Template",
  "type": "module",
  "scripts": {
    "configure": "node scripts/configure_issuer.mjs",
    "check:config": "node scripts/configure_issuer.mjs --check",
    "check:preflight": "node scripts/configure_issuer.mjs --check --strict",
    "check:deployer": "node scripts/deploy_checked.mjs --preflight-only",
    "deploy:checked": "node scripts/deploy_checked.mjs",
    "build": "node scripts/build_v3.mjs",
    "build:legacy": "psyup build",
    "build:deploy": "npm run check:preflight && npm run build",
    "deploy:v3": "node scripts/deploy_v3_checked.mjs",
    "test": "node scripts/run_unit_test.mjs"
  },
  "author": "Psy Protocol",
  "license": "MIT"
}
